# GEMINI_API_KEY: Required for server-side Gemini 3.8 Flash AI Sales Agent calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# PORT: The port the Express/Vite server listens on (default 3000)
PORT=3000

# OPTIONAL EXTERNAL INTEGRATIONS (Marked CONFIGURATION REQUIRED until credentials provided)
# STRIPE_SECRET_KEY / PAYMENT_GATEWAY_KEY: For processing live package payments and deposits
STRIPE_SECRET_KEY=""
PAYMENT_WEBHOOK_SECRET=""

# SMTP / RESEND_API_KEY: For automated email dispatch of lead notifications & booking confirmations
RESEND_API_KEY=""
NOTIFICATION_EMAIL="ghaziwazirndm@gmail.com"

# GOOGLE_CALENDAR_CLIENT_ID / SECRET: For bi-directional Google Calendar sync of Bahrain consultations
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""

# FIREBASE CONFIGURATION (For standalone cloud deployment)
# VITE_FIREBASE_API_KEY=""
# VITE_FIREBASE_AUTH_DOMAIN=""
# VITE_FIREBASE_PROJECT_ID=""
