rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: default deny everything
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------
    // Hardened Global Primitives (No custom auth claims)
    // -------------------------------------------------------------
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrappedCEO() {
      return isEmailVerified() && request.auth.token.email == 'ghaziwazirndm@gmail.com';
    }

    function userDocExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRoleIn(allowedRoles) {
      return isEmailVerified() && userDocExists() && getUserDoc().enabled == true && (getUserDoc().role in allowedRoles);
    }

    function isCEO() {
      return isBootstrappedCEO() || hasRoleIn(['CEO']);
    }

    function isAdmin() {
      return isBootstrappedCEO()
        || (isEmailVerified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)))
        || hasRoleIn(['CEO', 'ADMIN']);
    }

    function isSales() {
      return isAdmin() || hasRoleIn(['SALES']);
    }

    function isSupport() {
      return isAdmin() || hasRoleIn(['SUPPORT']);
    }

    function isFinance() {
      return isAdmin() || hasRoleIn(['FINANCE']);
    }

    function isStaff() {
      return isBootstrappedCEO() || hasRoleIn(['CEO', 'ADMIN', 'SALES', 'SUPPORT', 'FINANCE', 'VIEWER']);
    }

    // -------------------------------------------------------------
    // Validation Blueprints (Type, Size, Keys, Identity Integrity)
    // -------------------------------------------------------------
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'name', 'email', 'role', 'enabled', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'name', 'email', 'role', 'enabled', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.role is string && data.role in ['CEO', 'ADMIN', 'SALES', 'SUPPORT', 'FINANCE', 'VIEWER', 'USER']
        && data.enabled is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminMarker(data) {
      return data.keys().hasAll(['uid', 'role', 'grantedBy', 'createdAt'])
        && data.keys().hasOnly(['uid', 'role', 'grantedBy', 'createdAt'])
        && isValidId(data.uid)
        && data.role is string && data.role in ['CEO', 'ADMIN']
        && data.grantedBy is string && data.grantedBy.size() >= 1 && data.grantedBy.size() <= 128
        && data.createdAt is timestamp;
    }

    function isValidSystemSetting(data) {
      return data.keys().hasAll(['key', 'enabled', 'updatedBy', 'updatedAt'])
        && data.keys().hasOnly(['key', 'enabled', 'updatedBy', 'updatedAt'])
        && data.key is string && data.key.size() >= 1 && data.key.size() <= 80
        && data.enabled is bool
        && data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128
        && data.updatedAt is timestamp;
    }

    function isValidLead(data) {
      return data.keys().hasAll(['name', 'email', 'phone', 'serviceName', 'stage', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['name', 'email', 'phone', 'serviceName', 'stage', 'assignedTo', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.phone is string && data.phone.size() >= 3 && data.phone.size() <= 40
        && data.serviceName is string && data.serviceName.size() >= 1 && data.serviceName.size() <= 120
        && data.stage is string && data.stage in ['NEW', 'CONTACTED', 'QUALIFIED', 'BOOKED', 'CONSULTATION', 'PROPOSAL', 'NEGOTIATION', 'PAYMENT_PENDING', 'WON', 'LOST', 'NURTURE']
        && (!data.keys().hasAny(['assignedTo']) || (data.assignedTo is string && data.assignedTo.size() >= 1 && data.assignedTo.size() <= 128))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBooking(data) {
      return data.keys().hasAll(['clientName', 'clientEmail', 'slotDate', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['clientName', 'clientEmail', 'slotDate', 'status', 'createdAt', 'updatedAt'])
        && data.clientName is string && data.clientName.size() >= 1 && data.clientName.size() <= 120
        && data.clientEmail is string && data.clientEmail.size() >= 3 && data.clientEmail.size() <= 254
        && data.slotDate is string && data.slotDate.size() >= 8 && data.slotDate.size() <= 32
        && data.status is string && data.status in ['PENDING', 'CONFIRMED', 'COMPLETED', 'CANCELLED']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProposal(data) {
      return data.keys().hasAll(['leadId', 'title', 'amount', 'status', 'createdBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['leadId', 'title', 'amount', 'status', 'createdBy', 'createdAt', 'updatedAt'])
        && isValidId(data.leadId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && (data.amount is int || data.amount is float) && data.amount >= 0
        && data.status is string && data.status in ['DRAFT', 'PENDING_APPROVAL', 'APPROVED', 'SENT', 'REJECTED']
        && data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidApproval(data) {
      return data.keys().hasAll(['requesterId', 'riskTier', 'status', 'reason', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['requesterId', 'riskTier', 'status', 'reason', 'approverId', 'createdAt', 'updatedAt'])
        && isValidId(data.requesterId)
        && data.riskTier is string && data.riskTier in ['TIER_1', 'TIER_2', 'TIER_3']
        && data.status is string && data.status in ['PENDING', 'APPROVED', 'REJECTED']
        && data.reason is string && data.reason.size() >= 1 && data.reason.size() <= 500
        && (!data.keys().hasAny(['approverId']) || (data.approverId is string && data.approverId.size() >= 1 && data.approverId.size() <= 128))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAuditEntry(data) {
      return data.keys().hasAll(['actorId', 'action', 'sha256Hash', 'prevHash', 'createdAt'])
        && data.keys().hasOnly(['actorId', 'action', 'sha256Hash', 'prevHash', 'createdAt'])
        && data.actorId is string && data.actorId.size() >= 1 && data.actorId.size() <= 128
        && data.action is string && data.action.size() >= 1 && data.action.size() <= 120
        && data.sha256Hash is string && data.sha256Hash.size() >= 16 && data.sha256Hash.size() <= 128
        && data.prevHash is string && data.prevHash.size() >= 1 && data.prevHash.size() <= 128
        && data.createdAt is timestamp;
    }

    function isValidKnowledgeBaseItem(data) {
      return data.keys().hasAll(['title', 'body', 'published', 'updatedAt'])
        && data.keys().hasOnly(['title', 'body', 'published', 'updatedAt'])
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.body is string && data.body.size() >= 1 && data.body.size() <= 10000
        && data.published is bool
        && data.updatedAt is timestamp;
    }

    function isValidPayment(data) {
      return data.keys().hasAll(['leadId', 'amount', 'currency', 'status', 'recordedBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['leadId', 'amount', 'currency', 'status', 'recordedBy', 'createdAt', 'updatedAt'])
        && isValidId(data.leadId)
        && (data.amount is int || data.amount is float) && data.amount >= 0
        && data.currency is string && data.currency in ['BHD', 'USD', 'AED', 'SAR']
        && data.status is string && data.status in ['REQUESTED', 'VERIFIED', 'FAILED']
        && data.recordedBy is string && data.recordedBy.size() >= 1 && data.recordedBy.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // -------------------------------------------------------------
    // Collection Match Rules
    // -------------------------------------------------------------
    match /users/{userId} {
      // PII Protection: Only account owner or verified Admin/CEO can read a user document
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if false;

      // Bootstrapped CEO can provision their own CEO profile; Admin/CEO can create team profiles
      allow create: if isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == userId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (isBootstrappedCEO() && isOwner(userId) && incoming().role == 'CEO' && incoming().enabled == true)
          || (isAdmin() && incoming().role != 'CEO')
        );

      // Users can update only their display name (never role or enabled); Admin/CEO can manage roles
      allow update: if isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isOwner(userId) && isEmailVerified() && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'updatedAt']))
          || (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'role', 'enabled', 'updatedAt']) && (incoming().role != 'CEO' || isCEO()))
        );

      allow delete: if isValidId(userId) && isCEO() && userId != request.auth.uid;
    }

    match /admins/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if false;
      allow create: if isValidId(userId)
        && isValidAdminMarker(incoming())
        && incoming().uid == userId
        && incoming().createdAt == request.time
        && ((isBootstrappedCEO() && isOwner(userId) && incoming().role == 'CEO') || isCEO());
      allow update: if false;
      allow delete: if isValidId(userId) && isCEO() && userId != request.auth.uid;
    }

    match /system_settings/{settingId} {
      allow get: if isValidId(settingId) && isStaff();
      allow list: if false;
      allow create, update: if isValidId(settingId)
        && isValidSystemSetting(incoming())
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time
        && ((settingId == 'emergency_stop' && isCEO()) || (settingId != 'emergency_stop' && isAdmin()));
      allow delete: if false;
    }

    match /leads/{leadId} {
      allow get: if isValidId(leadId) && isStaff();
      allow list: if isSignedIn() && isEmailVerified() && existing().assignedTo == request.auth.uid;
      allow create: if isValidId(leadId)
        && isValidLead(incoming())
        && incoming().stage == 'NEW'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isStaff();
      allow update: if isValidId(leadId)
        && isValidLead(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (isSales() && incoming().diff(existing()).affectedKeys().hasOnly(['stage', 'assignedTo', 'updatedAt']))
          || (isSupport() && incoming().diff(existing()).affectedKeys().hasOnly(['stage', 'updatedAt']))
        );
      allow delete: if isValidId(leadId) && isAdmin();
    }

    match /bookings/{bookingId} {
      allow get: if isValidId(bookingId) && isStaff();
      allow list: if false;
      allow create: if isValidId(bookingId)
        && isValidBooking(incoming())
        && incoming().status == 'PENDING'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isStaff();
      allow update: if isValidId(bookingId)
        && isValidBooking(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && existing().status != 'CANCELLED'
        && (
          isAdmin()
          || (isSales() && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'slotDate', 'updatedAt']))
        );
      allow delete: if isValidId(bookingId) && isAdmin();
    }

    match /proposals/{proposalId} {
      allow get: if isValidId(proposalId) && (isSales() || isFinance());
      allow list: if isSignedIn() && isEmailVerified() && existing().createdBy == request.auth.uid;
      allow create: if isValidId(proposalId)
        && isValidProposal(incoming())
        && exists(/databases/$(database)/documents/leads/$(incoming().leadId))
        && incoming().createdBy == request.auth.uid
        && incoming().status == 'DRAFT'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isSales();
      allow update: if isValidId(proposalId)
        && isValidProposal(incoming())
        && incoming().leadId == existing().leadId
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (isSales() && existing().status == 'DRAFT' && incoming().status in ['DRAFT', 'PENDING_APPROVAL'] && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'amount', 'status', 'updatedAt']))
        );
      allow delete: if isValidId(proposalId) && isCEO();
    }

    match /approvals/{approvalId} {
      allow get: if isValidId(approvalId) && isStaff();
      allow list: if isSignedIn() && isEmailVerified() && existing().requesterId == request.auth.uid;
      allow create: if isValidId(approvalId)
        && isValidApproval(incoming())
        && incoming().requesterId == request.auth.uid
        && incoming().status == 'PENDING'
        && !incoming().keys().hasAny(['approverId'])
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isStaff();
      allow update: if isValidId(approvalId)
        && isValidApproval(incoming())
        && incoming().requesterId == existing().requesterId
        && incoming().riskTier == existing().riskTier
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && existing().status == 'PENDING'
        && incoming().approverId == request.auth.uid
        && existing().requesterId != request.auth.uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'approverId', 'updatedAt'])
        && ((existing().riskTier == 'TIER_3' && isCEO()) || (existing().riskTier != 'TIER_3' && isAdmin()));
      allow delete: if isValidId(approvalId) && isCEO();
    }

    match /audit_chain/{entryId} {
      allow get: if isValidId(entryId) && isAdmin();
      allow list: if false;
      allow create: if isValidId(entryId)
        && isValidAuditEntry(incoming())
        && incoming().actorId == request.auth.uid
        && incoming().createdAt == request.time
        && isStaff();
      allow update, delete: if false;
    }

    match /knowledge_base/{docId} {
      allow get: if isValidId(docId) && (existing().published == true || isAdmin());
      allow list: if existing().published == true;
      allow create, update: if isValidId(docId)
        && isValidKnowledgeBaseItem(incoming())
        && incoming().updatedAt == request.time
        && isAdmin();
      allow delete: if isValidId(docId) && isAdmin();
    }

    match /payments/{paymentId} {
      allow get: if isValidId(paymentId) && isFinance();
      allow list: if isSignedIn() && isEmailVerified() && existing().recordedBy == request.auth.uid;
      allow create: if isValidId(paymentId)
        && isValidPayment(incoming())
        && exists(/databases/$(database)/documents/leads/$(incoming().leadId))
        && incoming().recordedBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isFinance();
      allow update: if isValidId(paymentId)
        && isValidPayment(incoming())
        && incoming().leadId == existing().leadId
        && incoming().recordedBy == existing().recordedBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && existing().status != 'VERIFIED'
        && (isAdmin() || (isFinance() && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])));
      allow delete: if isValidId(paymentId) && isCEO();
    }
  }
}
